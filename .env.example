# Folder with your projects. It's mounted at the same path inside the container.
# Several folders: separate with commas, and add a volume line for each extra one in docker-compose.yml.
WORKSPACE=/home/you/code

# Optional. Leave empty and Hangar shows a setup page on first visit; get the one-time code from
# `docker compose logs hangar`. If set, Hangar skips setup and creates the owner account "admin"
# with this password.
HANGAR_PASSWORD=

# Where the web UI listens. 0.0.0.0 = every interface (LAN + Tailscale). Use 127.0.0.1 for this machine only.
HANGAR_BIND=0.0.0.0
HANGAR_PORT=7878

# Name shown in the UI. Defaults to the container hostname.
HANGAR_HOSTNAME=

# Match your host user so files Claude writes are owned by you (run `id -u` and `id -g`).
UID=1000
GID=1000

TZ=America/Denver

# Reopen sessions that were running when the container stopped.
HANGAR_AUTORESTORE=true

# Largest file you can upload from the browser, in MB.
HANGAR_MAX_UPLOAD_MB=512

# Extra arguments for every Claude session, e.g. --permission-mode acceptEdits
HANGAR_CLAUDE_ARGS=

# Let Claude install packages with sudo. Claude asks you before every sudo command. Set false to turn off.
ALLOW_SUDO=true

# Extra Debian packages baked into the image, e.g. "build-essential golang nodejs npm"
EXTRA_PACKAGES=

# Claude Code's login and history. Leave unset and Hangar keeps its own; you sign in during setup.
# Set it to share the host's Claude Code login and history (sessions then resume on both sides).
# CLAUDE_DIR=/home/you/.claude

# Only for docker-compose.tailscale.yml
TS_AUTHKEY=
TS_HOSTNAME=hangar
